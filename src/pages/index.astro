---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import AIUsage from "../components/AIUsage.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-8 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <h1 class="text-5xl font-bold">I'm Michael Li</h1>
    <div class="text-2xl md:text-3xl py-3 font-bold">Financial Planning &amp; Analysis</div>
    <div class="text-base text-base-content/70 mb-3">
      Columbia University · M.A. in Quantitative Methods in the Social Sciences · Graduating Dec 2026
    </div>
    <div class="max-w-4xl py-2 text-base text-base-content/90 md:text-lg">
      <p>
        I'm a Columbia University M.A. candidate in Quantitative Methods in the Social Sciences, with a B.A. in Computer Science and Economics from Boston University. My focus is FP&amp;A: budgeting, rolling forecasts, P&amp;L and variance analysis, and scenario and sensitivity modeling that show what drives business performance and support better decisions. I've built this through internships in private equity, a search fund, investment banking and fixed income, where I worked on financial models, valuation, operating budgets and management reporting. I combine finance with data skills in Excel, VBA, Power BI, SQL and Python to turn numbers into clear insights.
      </p>
    </div>

    <div class="mt-5">
      <a class="btn btn-outline" href="/contact">Let's connect</a>
    </div>
  </div>

  <section class="mt-6" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="text-3xl w-full font-bold mb-4">Experience</h2>
    <ul class="list-disc pl-5 space-y-2 text-base">
      <li>Investment Analyst Intern (Private Equity) · 3Q Investment Partners · Apr 2026 – Sep 2026</li>
      <li>Investment Analyst Intern (Search Fund) · Ionian Pine Partners · Apr 2026 – May 2026</li>
      <li>Investment Banking Summer Analyst · CICC · May 2024 – Jun 2024</li>
      <li>Fixed Income Summer Analyst · Haitong Securities · Jul 2023 – Aug 2023</li>
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="education-heading">
    <h2 id="education-heading" class="text-3xl w-full font-bold mb-4">Education</h2>
    <ul class="list-disc pl-5 space-y-2 text-base">
      <li>Columbia University · M.A. in Quantitative Methods in the Social Sciences · Dec 2026</li>
      <li>Boston University · B.A. in Computer Science &amp; Economics · 2025</li>
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="text-3xl w-full font-bold mb-4">Skills</h2>
    <p class="text-base">FP&amp;A · Financial Modeling · Excel/VBA · Power BI · SQL · Python · Bloomberg · AI tools &amp; agentic workflows (Codex, Claude Code, ChatGPT, Grok Bot) · Prompt engineering.</p>
  </section>

  <div class="mt-14">
    <h2 class="text-3xl w-full font-bold mb-2">Selected analytical projects</h2>
    <p class="text-base-content/80 mb-4">Projects in time-series forecasting and customer analysis that complement my finance experience.</p>
  </div>

  <HorizontalCard
    title="SEC Financial Data Infrastructure - KPMG Practicum"
    icon="search"
    desc="An ongoing Columbia QMSS practicum building SEC 10-K/10-Q data infrastructure. I own database and integration work, with a PostgreSQL foundation and a partial manual sample for future RAG/GraphRAG research."
    url="/kpmg-practicum"
    target="_self"
    badge="In progress"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Wave Height Prediction — Surf Vacation Planner"
    icon="wave"
    desc="A time-series forecasting app that predicts ocean wave heights using Facebook Prophet and NOAA buoy data, helping surfers find optimal locations and dates for their next trip."
    url="/cs506-wave-prediction"
    target="_self"
    badge="Forecasting"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Predicting Customer Churn Using KNN"
    icon="churn"
    desc="A Kaggle project using K-nearest neighbors to predict customer churn, exploring a business question relevant to customer retention and revenue planning."
    url="https://github.com/michaelliruoxi/mlrx-assignment-5"
    badge="Customer Analytics"
  />
  <div class="mt-4">
    <a class="link link-hover font-medium" href="/projects">View all projects →</a>
  </div>

  <section class="mt-14" aria-labelledby="how-i-use-ai-heading">
    <h2 id="how-i-use-ai-heading" class="text-3xl w-full font-bold mb-4">How I use AI</h2>
    <p class="max-w-4xl text-base text-base-content/90 md:text-lg">
      I'm always staying on top of AI and exploring new ways to improve my workflow with it, from Codex, Claude Code and Grok Bot to Meta Muse, OpenClaw, Hermes, ChatGPT Dots, Granola and more. I'm building AI-powered workflows that help me and my team work smarter, and I'm always learning. Happy to chat about AI with anyone!
    </p>
  </section>

  <AIUsage />
</BaseLayout>
