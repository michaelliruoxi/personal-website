---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const blogPosts = await getCollection("blog");
blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPost = blogPosts[0];
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-8 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <h1 class="text-5xl font-bold">I'm Michael Li</h1>
    <div class="text-2xl md:text-3xl py-3 font-bold">Financial Planning &amp; Analysis</div>
    <div class="text-base text-base-content/70 mb-3">Columbia University · M.A. in Quantitative Methods in the Social Sciences</div>
    <div class="max-w-4xl space-y-3 py-2 text-base text-base-content/90 md:text-lg">
      <p>
        I am a Columbia QMSS graduate student with a background in economics and computer science from Boston University. My focus is FP&amp;A: using financial modeling and data analysis to support business planning and better decisions. I am interested in budgeting, forecasting, and variance analysis to understand what drives business performance.
      </p>
      <p>
        My experience includes LBO analysis, valuation, and due diligence at 3Q Investment Partners; real estate research at Ionian Pine Partners; and IPO valuation, financial diligence, and fixed-income research at CICC and Haitong Securities. I bring skills in Excel, Python, and SQL alongside training in econometrics to analyze data, assess assumptions, and communicate findings clearly.
      </p>
      <p class="font-medium">I am looking for full-time opportunities in FP&amp;A and corporate finance.</p>
    </div>

    <div class="mt-5">
      <a class="btn btn-outline" href="/contact">Let's connect</a>
    </div>
  </div>

  <div>
    <h2 class="text-3xl w-full font-bold mb-2">Selected analytical projects</h2>
    <p class="text-base-content/80 mb-4">Projects in time-series forecasting and customer analysis that complement my finance experience.</p>
  </div>

  <HorizontalCard
    title="Wave Height Prediction — Surf Vacation Planner"
    img="/remagic_cover.jpeg"
    desc="A time-series forecasting app that predicts ocean wave heights using Facebook Prophet and NOAA buoy data, helping surfers find optimal locations and dates for their next trip."
    url="/cs506-wave-prediction"
    target="_self"
    badge="Forecasting"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Predicting Customer Churn Using KNN"
    icon="churn"
    desc="A Kaggle project using K-nearest neighbors to predict customer churn, exploring a business question relevant to customer retention and revenue planning."
    url="https://github.com/michaelliruoxi/mlrx-assignment-5"
    badge="Customer Analytics"
  />
  <div class="mt-4">
    <a class="link link-hover font-medium" href="/projects">View all projects →</a>
  </div>

  {
    latestPost && (
      <>
        <div class="mt-14 mb-3">
          <h2 class="text-3xl w-full font-bold mb-2">Blog / Journal</h2>
          <p class="text-base-content/80 max-w-3xl">
            Here are my most recent blogs.
          </p>
        </div>
        <HorizontalCard
          title={latestPost.data.title}
          desc={latestPost.data.description}
          url={`/blog/${createSlug(latestPost.data.title, latestPost.slug, latestPost.data.slug)}`}
          target="_self"
          badge="Latest entry"
          tags={latestPost.data.tags}
        />
        <div class="mt-4">
          <a class="btn btn-outline" href="/blog">Read the journal</a>
        </div>
      </>
    )
  }

</BaseLayout>
