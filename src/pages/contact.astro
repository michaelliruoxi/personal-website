---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Michael Li"
  description="Contact Michael Li about financial planning and analysis, financial modeling, and quantitative work."
  sideBarActiveItemID="contact"
>
  <div class="mb-5">
    <h1 class="text-3xl w-full font-bold">Contact</h1>
  </div>

  <div class="mb-10">
    <p class="text-lg mb-6">Get in touch — I’m happy to connect.</p>
    <p class="text-lg">
      <span class="font-semibold">Email</span>
      —
      <a href="mailto:michaelliruoxi@gmail.com" class="link link-hover">michaelliruoxi@gmail.com</a>
    </p>
    <p class="text-lg mt-6">
      I also welcome conversations about financial modeling, business analytics, and research collaborations.
    </p>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold mb-5">Elsewhere</div>
  </div>
  <div class="mb-10 text-lg opacity-75">
    <p>GitHub, LinkedIn, and Steam — linked in the sidebar.</p>
  </div>
</BaseLayout>
