---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Michael Li"
  description="Connect with Michael Li about full-time opportunities in Financial Planning & Analysis (FP&A), corporate finance, and financial analytics."
  sideBarActiveItemID="contact"
>
  <div class="mb-5">
    <h1 class="text-3xl w-full font-bold">Contact</h1>
  </div>

  <div class="mb-10">
    <p class="text-lg mb-6">I am looking for full-time opportunities in FP&amp;A and corporate finance. Get in touch — I’m happy to connect.</p>
    <p class="text-lg">
      <span class="font-semibold">Email</span>
      —
      <a href="mailto:rl3592@columbia.edu" class="link link-hover">rl3592@columbia.edu</a>
    </p>
    <p class="text-lg mt-6">
      I also welcome conversations about financial modeling, business analytics, and research collaborations.
    </p>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold mb-5">Elsewhere</div>
  </div>
  <div class="mb-10 text-lg opacity-75">
    <p>GitHub, LinkedIn, and Steam — linked in the sidebar.</p>
  </div>
</BaseLayout>
