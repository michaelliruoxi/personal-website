---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout
  title="Projects | Michael Li"
  description="Forecasting, customer analytics, and quantitative research projects by Michael Li, a Columbia QMSS graduate student focused on FP&A."
  sideBarActiveItemID="projects"
>
  <div>
    <h1 class="text-3xl w-full font-bold mb-3">Projects</h1>
    <p class="text-base-content/80 mb-6">These projects complement my finance experience with hands-on work in forecasting, customer analytics, and statistical modeling.</p>
  </div>

  <h2 class="text-2xl font-bold mb-3">Forecasting &amp; business analytics</h2>
  <HorizontalCard
    title="Wave Height Prediction — Surf Vacation Planner"
    img="/remagic_cover.jpeg"
    desc="A time-series forecasting app that predicts ocean wave heights using Facebook Prophet and NOAA buoy data, helping surfers find optimal locations and dates for their next trip."
    url="/cs506-wave-prediction"
    target="_self"
    badge="Forecasting"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Predicting Customer Churn Using KNN"
    icon="churn"
    desc="A Kaggle project using K-nearest neighbors to predict customer churn, exploring a business question relevant to customer retention and revenue planning."
    url="https://github.com/michaelliruoxi/mlrx-assignment-5"
    badge="Customer Analytics"
  />

  <h2 class="text-2xl font-bold mb-3 mt-10">Machine learning &amp; research</h2>
  <HorizontalCard
    title="LLM Evaluation Pipeline for Robust QA"
    img="/llm_evaluation_pipeline.png"
    desc="Designed an end-to-end LLM evaluation pipeline for noisy QA inputs: prompt repair, multi-model benchmarking, automated metrics, and error analysis to quantify robustness and deployment risk."
    url="https://github.com/michaelliruoxi/medical_llm_project"
    badge="LLM Evaluation"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="COVID-19 Chest X-Ray Classification with Deep Learning"
    img="/chest_xray.jpg"
    desc="Built and compared six CNN architectures (custom and transfer learning) to classify chest X-rays as COVID-19, Normal, or Viral Pneumonia — achieving 95.7% accuracy and 0.99 AUC."
    url="https://github.com/michaelliruoxi/medical_deeplearning"
    badge="Deep Learning"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Natural Language Processing for Student Rating Prediction"
    img="/nlp_cover.png"
    desc="How do students really think about their professors? I used NLP on 20k+ RateMyProfessor reviews to predict star ratings from the text — and got accuracy up to ~69%."
    url="https://github.com/michaelliruoxi/prof_rating_nlp"
    badge="NLP"
  />
  <div>
    <h2 class="text-2xl w-full font-bold mb-5 mt-10">Statistical &amp; technical explorations</h2>
  </div>

  <HorizontalCard
    title="KMeans Clustering with Visualization"
    icon="kmeans"
    desc="KMeans clustering algorithm with visualization. Includes demo video."
    url="https://github.com/michaelliruoxi/mlrx-assignment-2"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Search Engine"
    icon="search"
    desc="Search engine project with demo video."
    url="https://github.com/michaelliruoxi/mlrx-assignment-4"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Kaggle: Amazon Movie Review Star Rating"
    icon="star"
    desc="Kaggle competition — predicting star rating for Amazon movie reviews."
    url="https://github.com/michaelliruoxi/mlrx-cs506-midterm"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Linear Regression Experiments"
    icon="regression"
    desc="Linear regression experiments with demo video."
    url="https://github.com/michaelliruoxi/mlrx-assignment-6"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Hypothesis Testing and Confidence Intervals in Linear Regression"
    icon="hypothesis"
    desc="Hypothesis testing and confidence intervals in linear regression. Includes demo video."
    url="https://github.com/michaelliruoxi/mlrx-assignment-7"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Logistic Regression Cluster Shift Experiment"
    icon="logistic"
    desc="Logistic regression cluster shift experiment with demo video."
    url="https://github.com/michaelliruoxi/mlrx-assignment-8"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Visualizing Neural Networks"
    icon="neural"
    desc="Visualizing neural networks with demo video."
    url="https://github.com/michaelliruoxi/mlrx-assignment-9"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Identifying Credit Card Fraud"
    icon="fraud"
    desc="Identifying credit card fraud using machine learning."
    url="https://github.com/michaelliruoxi/mlrx-cs506-extracredit"
  />
</BaseLayout>
